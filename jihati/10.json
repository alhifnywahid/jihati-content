  "id": 10,
  "title": {
    "arabic": "يَا اَرْحَمَ الرَّاحِمِيْنَ",
    "latin": "Ya Arhamar Rahimin"
  },
  "content": [
    [
      "يَا أَرْحَمَ الرَّاحِمِيْنَ",
      "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    ],
    [
      "يَا أَرْحَمَ الرَّاحِمِيْنَ",
      "فَرِّجِ عَلَى الْمُسْلِمِيْنَ"
    ],
    [
      "يَا رَبَّنَا يَا كَرِيْمُ",
      "يَا رَبَّنَا يَا رَحِيْمُ"
    ],
    [
      "اَنْتَ الْجَوَادُ الحَلِيْمُ",
      "وَأَنْتَ نِعْمَ المُعِيْنُ"
    ],
    [
      "وَلَيْسَ نَرْجُوْ سِوَاكَ",
      "فَادْرِكَ اِلٰهِيْ دَارَكَ"
    ],
    [
      "قَبْلَ اْلفَنَاءِ وَالْهَلَاكِ",
      "يَعْمُ الدُّنْيَا وَالدِّيْنَ"
    ],
    [
      "وَمَا لَنَا رَبُّنَا",
      "سِوَاكَ يَا حَسْبَنَا"
    ],
    [
      "يَاذَا الْعُلىٰ وَالْغِنَا",
      "يَا قَوِيٌّ يَا مَتِيْنُ"
    ],
    [
      "نَسْأَلُكَ وَالِي يُقِيْمُ",
      "الْعَدْلَ كَيْ نَسْتَقِيْمَ"
    ],
    [
      "عَلىٰ هُدَاكَ القَوْمِ",
      "وَلَا تُطِيْعُ اللَّعِيْنَ"
    ],
    [
      "يَا رَبَّنَا يَا مُجِيْبُ",
      "أَنْتَ السَّمِيْعُ اْلقَرِيْبُ"
    ],
    [
      "ضَافَ الوَسِيْعُ الرَّحِيْبُ",
      "فَانْظُرُ إِلَى الْمُؤْمِنِيْنَ"
    ],
    [
      "نَظْرَةً تُزِيْلُ اْلعَنَا",
      "عَنَّا وَتُدْنِي المُنٰا"
    ],
    [
      "مِنَّا وَكُلَّ الْمَنَا",
      "نَعْطَاهُ فِي كُلِّ حِينٍْ"
    ],
    [
      "نَسْأَلُكَ بِجَاهِ الْجُدُوْدِ",
      "وَالِي يُقِيْمُ الحُدُوْد"
    ],
    [
      "فِيْنَا وَيَكْفِي اْلحَسُوْدُ",
      "وَيَدْفَعُ الظَّالِمِيْنَ"
    ],
    [
      "يُزِيْلُ لِلْمُنْكَرَاتُ",
      "يُقِيْمُ لِلصَّلَوَاتُ"
    ],
    [
      "يَأْمُرُ بِالصَّالِحَاتُ",
      "مُحِبُّ لِلصَّالِحِيْنَ"
    ],
    [
      "يُزِيْحُ كُلَّ الْخَرَامُ",
      "يَقْهَرُ كُلَّ الطَّعَامُ"
    ],
    [
      "يَعْدِلُ بَيْنَ الأَنَامُ",
      "وَيُؤْمِنُ الْخَائِفِيْنَ"
    ],
    [
      "رَبِّ اسْقِنَا غَيْثَ عَامُ",
      "نَافِعُ مُبَارَكٌ دَوَامُ"
    ],
    [
      "يَدُومُْ فِي كُلِّ عَامُ",
      "عَلَى مَمَرَ السِّنِينَ"
    ],
    [
      "رَبِّ احْيِنَا شَاكِرِيْنَ",
      "وَتَوَفَّنَا مُسْلِمِيْنَ"
    ],
    [
      "نُبْعَثَ مِنَ الأٰمِنِينَ",
      "فِي زُمْرَةِ السَّابِقِيْنَ"
    ],
    [
      "بِجَاهِ ظُهُ الرَّسُولُ",
      "جُدْ رَبَّنَا بِالْقَبُوْل"
    ],
    [
      "وَهَبْ لَنَا كُلَّ سُوْل",
      "رَبِّ اسْتَجِبْ لِي أٰمِيْن"
    ],
    [
      "عَطَاكَ رَبِّي جَزِيْل",
      "وَكُلِّ فِعْلِكَ جَمِيل"
    ],
    [
      "وَفِيكَ اَمَلْنَا طَوِيْل",
      "فَجُدْ عَلَى الطَّامِعِينَ"
    ],
    [
      "يَا رَبِّ ضَاقَ الْخِنَاقْ",
      "مِنْ فِعْلِ مَا لَا يُطَاقُ"
    ],
    [
      "فَامْنُنْ بِفَكِ الْغَلَاقُ",
      "فِي لِمَنْ بِذَنْبِهِ رَهِينْ"
    ],
    [
      "وَاغْفِرْ لِكُلِّ الذُّنُوبْ",
      "وَاسْتُرْ لِكُلِّ الْعُيُوبْ"
    ],
    [
      "وَاكْشِفُ لِكُلِّ الكُرُوبْ",
      "وَاكْفِ أَذَى الْمُؤْذِبِينَ"
    ],
    [
      "وَاحْتِمُ بِأَحْسَنُ خِتَامُ",
      "إِذَا دَنَا الإِنْصِرَامْ"
    ],
    [
      "وَحَانَ حِينُ الحِمَامُ",
      "فِي وَزَادَ رَشحُ الْجَبِيْن"
    ],
    [
      "ثُمَّ الصَّلَاةُ وَالسَّلاَمُ",
      "عَلَى شَفِيعِ الأَنَامْ"
    ],
    [
      "والاٰلِ نِعْمَ الكِرَامُ",
      "وَالصَّحْبِ وَالتَّابِعِينَ"
    ]
  ]
}
